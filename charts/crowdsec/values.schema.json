              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            },
            "trafficDistribution": {
              "type": "string"
            },
            "nodePorts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "extraSpec": {
              "type": "object",
              "description": "Extra Service spec fields (not type, selector, ports)"
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "updateStrategy": {
          "type": "object"
        }
      }
    }
  }
}
